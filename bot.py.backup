        d, h = days_left
        time_str = f"*{d} din {h} ghante* bache"
        warn = "⚠️ " if d <= 3 else "⏰ "
    else:
        time_str = "*Unlimited*"
        warn = "♾️ "

    exp_str = r[5][:10] if r[5] else "—"

    text = (
        "╔══════════════════════════╗\n"
        "   🏪 *RESELLER DASHBOARD*\n"
        "╚══════════════════════════╝\n\n"
        f"👤 Name: *{r[1]}*\n"
        f"🆔 ID: `{uid}`\n"
        f"💳 UPI: `{r[2]}`\n"
        f"🖼️ QR: {qr_status}\n\n"
        f"{warn}Plan Valid Till: *{exp_str}*\n"
        f"{warn}Time Left: {time_str}\n\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
        "  📊 *YOUR STATISTICS*\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
        f"  👥 Customers   ➜  *{customers}*\n"
        f"  📦 Stock       ➜  *{stock} keys*\n"
        f"  ⏳ Pending     ➜  *{pend}*\n"
        f"  ✅ Approved    ➜  *{appr}*\n"
        f"  💰 Revenue     ➜  *₹{rev}*\n\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
        "  🔗 *YOUR REFERRAL LINK*\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
        f"`{ref_link}`\n\n"
        "☝️ Ye link share karo customers ko!"
    )
    kb = [
        [InlineKeyboardButton("🔗 Get Link",  callback_data="res_link"),
