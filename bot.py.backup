# ==================== PAYMENT ====================
async def send_payment(update, context, plan_key):
    plan = PLANS[plan_key]
    uid = update.effective_user.id
    seller_id = get_user_seller(uid)
    seller = get_seller_info(seller_id)

    pending[uid] = {"plan": plan_key, "photo": None, "utr": None,
                    "seller_id": seller_id}

    caption = (
        "╔══════════════════════════╗\n"
        f"  {plan['emoji']} *{plan['name'].upper()} PLAN* {plan['emoji']}\n"
        "╚══════════════════════════╝\n\n"
        f"💰 *Amount:* ₹{plan['price']}\n"
        f"⏳ *Validity:* {plan['days']} din\n\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
        "  📱 *PAYMENT STEPS*\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
        "  1️⃣ Upar wala QR scan karo\n"
        "  2️⃣ Ya UPI ID pe bhejo:\n"
        f"     `{seller['upi']}`\n"
        f"  3️⃣ ₹{plan['price']} pay karo\n\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
        "  📤 *AB YE BHEJO*\n"
        "━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n"
        "  📸 Payment ka *screenshot*\n"
        "  🧾 *UTR / Transaction ID*\n\n"
        "⏳ Dono milne par admin verify karke\n"
        "tumhari *KEY* bhej dega 🔑"
    )
    msg = update.effective_message

    if seller["qr"] and os.path.exists(seller["qr"]):
        try:
            with open(seller["qr"], "rb") as f:
                await msg.reply_photo(f, caption=caption, parse_mode="Markdown")
            return
        except Exception as e:
            logging.error(f"QR fail: {e}")

    await msg.reply_text(caption + "\n\n⚠️ _QR available nahi, UPI ID use karo_",
                         parse_mode="Markdown")


# ==================== SCREENSHOT ====================
async def handle_photo(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id

    if uid in reseller_setup and reseller_setup[uid] == "awaiting_qr":
        try:
            file = await update.message.photo[-1].get_file()
            await file.download_to_drive(f"qr_{uid}.png")
            del reseller_setup[uid]
            await update.message.reply_text(
                "✅ *QR set ho gaya!*\n\n🖼️ Ab customers ko ye QR dikhega.",
                parse_mode="Markdown"
            )
        except Exception as e:
            logging.error(f"QR save: {e}")
            await update.message.reply_text("❌ QR save nahi hua. Dobara try karo.")
        return

    if uid not in pending:
        await update.message.reply_text("⚠️ Pehle /start dabao aur plan choose karo.")
        return

    pending[uid]["photo"] = update.message.photo[-1].file_id
    if pending[uid]["utr"]:
        await create_order(update, context, uid)
    else:
        await update.message.reply_text(
            "✅ *Screenshot mil gaya!*\n\n🧾 Ab *UTR / Transaction ID* bhejo.",
            parse_mode="Markdown"
        )


# ==================== TEXT ====================
async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    text = update.message.text.strip()

    if uid in reseller_setup and reseller_setup[uid] == "awaiting_upi":
        if "@" not in text or len(text) < 5:
            await update.message.reply_text("⚠️ Valid UPI bhejo (jaise `name@ybl`)",
                                            parse_mode="Markdown")
            return
        con = db(); c = con.cursor()
        c.execute("UPDATE resellers SET upi_id=? WHERE user_id=?", (text, uid))
        con.commit(); con.close()
        del reseller_setup[uid]
        await update.message.reply_text(f"✅ *UPI set!*\n\n💳 `{text}`",
                                        parse_mode="Markdown")
        return

    if uid not in pending:
        return
    if len(text) < 6:
        await update.message.reply_text("⚠️ Ye valid UTR nahi lag raha.")
        return

    pending[uid]["utr"] = text
    if pending[uid]["photo"]:
        await create_order(update, context, uid)
    else:
        await update.message.reply_text(
            "✅ *UTR note ho gaya!*\n\n📸 Ab screenshot bhejo.",
            parse_mode="Markdown"
        )


# ==================== ORDER CREATE ====================
async def create_order(update, context, uid):
    st = pending[uid]
    plan_key = st["plan"]
    plan = PLANS[plan_key]
    seller_id = st["seller_id"]
    user = update.effective_user

    con = db(); c = con.cursor()
    c.execute("""INSERT INTO orders(user_id, username, plan, price, status, utr, created_at, seller_id)
                 VALUES(?,?,?,?,?,?,?,?)""",
              (uid, user.username or "", plan_key, plan["price"],
               "pending", st["utr"], datetime.now().isoformat(), seller_id))
    oid = c.lastrowid
    con.commit(); con.close()
    del pending[uid]

    await update.message.reply_text(
        f"⏳ *Order #{oid} Submit Ho Gaya!*\n\n"
        f"📦 Plan: *{plan['name']}*\n"
        f"💰 Amount: *₹{plan['price']}*\n"
        f"🧾 UTR: `{st['utr']}`\n\n"
        "🔔 Admin verify karke key bhejega...",
        parse_mode="Markdown"
    )

    caption = (
        f"🔔 *NAYA ORDER #{oid}*\n\n"
        f"👤 {user.full_name}\n"
        f"🔖 @{user.username or '—'}\n"
        f"🆔 `{uid}`\n\n"
        f"📦 Plan: *{plan['name']}*\n"
        f"💰 Price: *₹{plan['price']}*\n"
        f"🧾 UTR: `{st['utr']}`\n\n"
        "👇 Verify karke decide karo:"
    )
    kb = InlineKeyboardMarkup([[
        InlineKeyboardButton("✅ Approve", callback_data=f"ok_{oid}"),
        InlineKeyboardButton("❌ Reject",  callback_data=f"no_{oid}")
    ]])

    recipients = ADMIN_IDS if seller_id == 0 else [seller_id]
    for r in recipients:
        try:
            await context.bot.send_photo(r, st["photo"], caption=caption,
                                         parse_mode="Markdown", reply_markup=kb)
        except Exception as e:
            logging.error(f"Notify {r}: {e}")


# ==================== CALLBACKS ====================
async def on_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    q = update.callback_query
    data = q.data
    uid = q.from_user.id

    if data in ("show_help", "res_help"):
        await q.answer()
        await q.message.reply_text(help_text(uid, reseller=is_reseller(uid)),
                                    parse_mode="Markdown")
        return

    if data == "res_link":
        await q.answer()
        link = f"https://t.me/{context.bot.username}?start=ref_{uid}"
        await q.message.reply_text(
            f"🔗 *YOUR REFERRAL LINK*\n\n`{link}`\n\n☝️ Share karo!",
            parse_mode="Markdown")
        return

    if data == "res_setqr":
        await q.answer()
        reseller_setup[uid] = "awaiting_qr"
        await q.message.reply_text("🖼️ *QR Setup*\n\nAb QR image bhejo 👇",
                                   parse_mode="Markdown")
        return

    if data == "res_setupi":
        await q.answer()
        reseller_setup[uid] = "awaiting_upi"
        await q.message.reply_text("💳 *UPI Setup*\n\nUPI ID bhejo (jaise `name@ybl`) 👇",
                                   parse_mode="Markdown")
        return

    if data == "res_stock":
        await q.answer()
        con = db(); c = con.cursor()
        txt = "📦 *YOUR STOCK*\n\n"
        total = 0
        for p in PLANS:
            c.execute("SELECT COUNT(*) FROM keys WHERE plan=? AND used=0 AND seller_id=?",
                      (p, uid))
            n = c.fetchone()[0]; total += n
            txt += f"{PLANS[p]['emoji']} {PLANS[p]['name']}: *{n}* keys\n"
        con.close()
        txt += f"\n📊 Total: *{total}* keys"
        await q.message.reply_text(txt, parse_mode="Markdown")
        return

    if data == "res_orders":
        await q.answer()
        con = db(); c = con.cursor()
        c.execute("""SELECT id, user_id, plan, utr FROM orders
                     WHERE status='pending' AND seller_id=? ORDER BY id""", (uid,))
        rows = c.fetchall(); con.close()
        if not rows:
            await q.message.reply_text("✅ Koi pending order nahi!", parse_mode="Markdown")
            return
        txt = "⏳ *YOUR PENDING ORDERS*\n\n"
        for r in rows:
            txt += f"🔔 #{r[0]} | {PLANS.get(r[2],{}).get('name',r[2])} | `{r[1]}` | UTR `{r[3]}`\n"
        await q.message.reply_text(txt, parse_mode="Markdown")
        return

    if data == "res_stats":
        await q.answer()
        con = db(); c = con.cursor()
        c.execute("SELECT COUNT(*) FROM orders WHERE seller_id=? AND status='approved'", (uid,))
        a = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM orders WHERE seller_id=? AND status='pending'", (uid,))
        p = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM orders WHERE seller_id=? AND status='rejected'", (uid,))
        r = c.fetchone()[0]
        c.execute("SELECT SUM(price) FROM orders WHERE seller_id=? AND status='approved'", (uid,))
        rev = c.fetchone()[0] or 0
        c.execute("SELECT COUNT(*) FROM users WHERE referred_by=?", (uid,))
        cust = c.fetchone()[0]
        con.close()
        days_left = reseller_days_left(uid)
        time_line = ""
        if days_left:
            d, h = days_left
            time_line = f"⏰ Plan Time: *{d}d {h}h*\n"
        await q.message.reply_text(
            f"📊 *YOUR STATISTICS*\n\n"
            f"👥 Customers: *{cust}*\n"
            f"✅ Approved: *{a}*\n"
            f"⏳ Pending: *{p}*\n"
            f"❌ Rejected: *{r}*\n"
            f"💰 Revenue: *₹{rev}*\n\n"
            f"{time_line}",
            parse_mode="Markdown")
        return

    if data.startswith("plan_"):
        pk = data.split("_", 1)[1]
        if pk in PLANS:
            await q.answer()
            await send_payment(update, context, pk)
        return

    if data.startswith(("ok_", "no_")):
        action, oid = data.split("_")
        oid = int(oid)

        con = db(); c = con.cursor()
        c.execute("SELECT user_id, plan, status, seller_id FROM orders WHERE id=?", (oid,))
        row = c.fetchone()
        if not row:
            await q.answer("Order nahi mila", show_alert=True); con.close(); return
        user_id, plan_key, status, seller_id = row

        if uid not in ADMIN_IDS and uid != seller_id:
            await q.answer("Tum is order ke owner nahi ho!", show_alert=True)
            con.close(); return
        if status != "pending":
            await q.answer("Already handled", show_alert=True); con.close(); return

        if action == "ok":
            c.execute("""SELECT id, key, days FROM keys
                         WHERE plan=? AND used=0 AND seller_id=? LIMIT 1""",
                      (plan_key, seller_id))
            k = c.fetchone()
            if not k:
                await q.answer(
                    f"❌ Tumhare stock me {plan_key} ki key nahi hai!\n"
                    f"/addkeys ya /genkeys chalao.",
                    show_alert=True)
                con.close(); return

            key_id, key, days = k
            now = datetime.now()
            exp = now + timedelta(days=days)
            c.execute("""UPDATE keys SET used=1, used_by=?, activated_at=?, expires_at=?
                         WHERE id=?""",
                      (user_id, now.isoformat(), exp.isoformat(), key_id))
            c.execute("UPDATE orders SET status='approved' WHERE id=?", (oid,))
            con.commit(); con.close()

            plan = PLANS[plan_key]
            try:
                await context.bot.send_message(
                    user_id,
                    f"🎉 *PAYMENT VERIFIED!* 🎉\n\n"
                    "╔══════════════════════════╗\n"
                    f"  {plan['emoji']} *YOUR KEY* {plan['emoji']}\n"
                    "╚══════════════════════════╝\n\n"
                    f"🔑 `{key}`\n\n"
                    f"📦 Plan: *{plan['name']}*\n"
                    f"⏳ Validity: *{days} din*\n"
                    f"📅 Expiry: *{exp.strftime('%d-%m-%Y')}*\n\n"
                    f"🚀 Enjoy karo!\n💬 Support: {SUPPORT}",
                    parse_mode="Markdown")
            except Exception as e:
                logging.error(f"Key send: {e}")

            try:
                await q.edit_message_caption(
                    caption=(q.message.caption or "") + "\n\n✅ *APPROVED*",
                    reply_markup=None)
            except Exception:
                pass
            await q.answer("Key bhej di ✅")

        else:
            c.execute("UPDATE orders SET status='rejected' WHERE id=?", (oid,))
            con.commit(); con.close()
            try:
                await context.bot.send_message(
                    user_id,
                    "❌ *Payment Verify Nahi Hua*\n\n"
                    "Sahi screenshot + UTR ke saath dobara try karo\n"
                    f"💬 Support: {SUPPORT}",
                    parse_mode="Markdown")
            except Exception:
                pass
            try:
                await q.edit_message_caption(
                    caption=(q.message.caption or "") + "\n\n❌ *REJECTED*",
                    reply_markup=None)
            except Exception:
                pass
            await q.answer("Reject kar diya")


# ==================== HELP ====================
def help_text(uid, reseller=False):
    text = (
        "📖 *COMMAND LIST*\n"
        "═══════════════════════════\n\n"
        "👤 *USER COMMANDS*\n"
        "├ /start — Welcome\n"
        "├ /help — Ye list\n"
        "├ /id — Apni ID\n"
        "└ /myorders — Orders\n"
    )
    if uid in ADMIN_IDS:
        text += (
            "\n👑 *ADMIN COMMANDS*\n"
            "├ /addreseller `<uid> <name> <upi> <days>`\n"
            "├ /extendreseller `<uid> <days>`\n"
            "├ /resellerinfo `<uid>`\n"
            "├ /removereseller `<uid>`\n"
            "├ /resellers — Sabki list\n"
            "├ /addkeys `<plan> <k1,k2>`\n"
            "├ /genkeys `<plan> <count>`\n"
            "├ /stock — Stock\n"
            "├ /orders — Pending\n"
            "├ /stats — Overall stats\n"
            "└ /broadcast `<msg>`\n"
        )
    if reseller:
        text += (
            "\n🏪 *RESELLER COMMANDS*\n"
            "├ /myinfo — Apni info + time\n"
            "├ /ref — Referral link\n"
            "├ /setqr — QR change\n"
            "├ /setupi `<upi>` — UPI change\n"
            "├ /addkeys `<plan> <k1,k2>`\n"
            "├ /genkeys `<plan> <count>`\n"
            "├ /stock — Apna stock\n"
            "├ /orders — Apne orders\n"
            "└ /stats — Apni sales\n"
        )
    text += f"\n═══════════════════════════\n💬 Support: {SUPPORT}"
    return text


async def help_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    await update.message.reply_text(help_text(uid, reseller=is_reseller(uid)),
                                    parse_mode="Markdown")


async def id_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    u = update.effective_user
    extra = ""
    if is_reseller(u.id):
        extra = "\n🏪 Status: *RESELLER*"
    elif get_user_seller(u.id) > 0:
        r = get_reseller(get_user_seller(u.id))
        extra = f"\n🏪 Seller: *{r[1] if r else '—'}*"
    await update.message.reply_text(
        f"🆔 *Tumhari Details*\n\n👤 {u.full_name}\n🔖 @{u.username or '—'}\n🆔 `{u.id}`{extra}",
        parse_mode="Markdown")


async def myorders_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    con = db(); c = con.cursor()
    c.execute("""SELECT id, plan, status FROM orders
                 WHERE user_id=? ORDER BY id DESC LIMIT 10""", (uid,))
    rows = c.fetchall(); con.close()
    if not rows:
        await update.message.reply_text("📭 Koi order nahi."); return
    emoji_map = {"pending": "⏳", "approved": "✅", "rejected": "❌"}
    txt = "📋 *Tumhare Orders*\n\n"
    for r in rows:
        txt += f"{emoji_map.get(r[2],'❔')} #{r[0]} — {PLANS.get(r[1],{}).get('name',r[1])} — *{r[2].upper()}*\n"
    await update.message.reply_text(txt, parse_mode="Markdown")


async def ref_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    uid = update.effective_user.id
    if not is_reseller(uid):
        await update.message.reply_text("Sirf resellers ke liye."); return
    link = f"https://t.me/{context.bot.username}?start=ref_{uid}"
    await update.message.reply_text(
        f"🔗 *YOUR REFERRAL LINK*\n\n`{link}`\n\n☝️ Share karo!",
